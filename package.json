{
  "name": "xhs-inspiration-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "APP_MODE=local APP_LOCAL_ONLY=1 next dev --hostname 127.0.0.1 --port 3000",
    "local:install": "node scripts/local-service.mjs install",
    "local:prepare": "node scripts/local-service.mjs prepare",
    "local:activate": "node scripts/local-service.mjs activate",
    "local:start": "node scripts/local-service.mjs start",
    "local:stop": "node scripts/local-service.mjs stop",
    "local:status": "node scripts/local-service.mjs status",
    "local:update": "node scripts/local-service.mjs update",
    "dev:auth-test": "node --conditions=react-server --import tsx scripts/start-permissions-test.ts",
    "build": "next build --webpack",
    "start": "APP_MODE=local APP_LOCAL_ONLY=1 next start --hostname 127.0.0.1",
    "start:local": "APP_MODE=local APP_LOCAL_ONLY=1 GENERATION_TIMEOUT_PROFILE=local next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --import ./tests/setup.ts --test --test-timeout=30000 tests/*.test.ts",
    "test:api": "node --import tsx scripts/api-smoke.ts",
    "test:fixtures": "node --import tsx scripts/create-fixtures.ts",
    "start:cloud": "APP_MODE=cloud APP_LOCAL_ONLY=0 next start --hostname 0.0.0.0"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.18.7",
    "fast-xml-parser": "^5.11.2",
    "jsonwebtoken": "9.0.3",
    "lucide-react": "latest",
    "next": "16.4.3",
    "openai": "7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0",
    "lodash.set": "file:./vendor/lodash-set-safe"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "@cloudbase/node-sdk": {
      "axios": "1.21.0"
    },
    "@cloudbase/database": {
      "lodash.set": "$lodash.set",
      "lodash.unset": "4.18.0"
    }
  },
  "license": "MIT",
  "description": "面向小红书创作者的本地 AI 工作台，支持选题、图文与分镜创作及自有模型配置。",
  "repository": {
    "type": "git",
    "url": "https://github.com/AcolasiaK/xhs-inspiration-studio.git"
  }
}
