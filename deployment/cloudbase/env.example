# Fill these values only in your own CloudBase console. Never commit real values.
APP_MODE=cloud
APP_LOCAL_ONLY=0
CLOUD_BACKEND=cloudbase
# Set after verifying both database collection and storage are private. This flag
# does not verify policy by itself; follow DEPLOY_CLOUDBASE.md first.
CLOUD_PRIVATE_RESOURCES_CONFIRMED=0
# Obtain the actual default HTTPS service address from the console, without a trailing slash.
APP_ORIGIN=https://your-service.example.invalid
CLOUDBASE_ENV_ID=your-cloudbase-environment-id
CLOUDBASE_COLLECTION=xhs_records
# Prefer the console's API Key setting to inject CLOUDBASE_APIKEY. Do not add a
# duplicate variable or use a client Publishable Key. The SDK receives accessKey
# explicitly when a platform API Key is present and no explicit pair is set.
# Optional only when an adequately scoped service role is not available.
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
# Paste the hashes from the locally generated .env.cloud.secrets, not the original passphrases.
SITE_ACCESS_HASH=
ADMIN_BOOTSTRAP_HASH=
# Generate a different random secret locally; also configure it in the timer function.
CLOUD_CRON_SECRET=
# Each user adds their own model API key in AI settings. No shared model credential is supplied.
# Optional separate Bocha Web Search API key. Leave empty to generate without live search.
BOCHA_API_KEY=
